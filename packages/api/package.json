{
  "name": "sales-agent-api",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch watch.ts",
    "build": "tsc",
    "start": "node --import tsx watch.ts",
    "lint": "tsc --noEmit",
    "test": "jest --config test/jest.config.cjs",
    "migrate": "node --import tsx node_modules/node-pg-migrate/bin/node-pg-migrate.js -f database/config/migrate-config.cjs -m database/migrations --ignore-pattern \"README.md\" up",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "seed:admin:dist": "node dist/src/scripts/seedAdmin.js"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "ioredis": "^6.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "fast-jwt": ">=6.3.3",
    "glob": ">=11.1.0"
  }
}
