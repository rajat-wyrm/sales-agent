# Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env files containing real secrets.

# === Database ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leads_db

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Auth ===
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# === Encryption (REQUIRED, min 32 chars - encrypts API keys at rest) ===
ENCRYPTION_SECRET=change-this-to-another-long-random-string-min-32-chars

# === Webhook signature secrets (recommended in prod) ===
# Resend webhook signing secret (svix, from Resend dashboard)
RESEND_WEBHOOK_SECRET=
# Meta/WhatsApp Cloud API app secret (X-Hub-Signature-256 verification)
WHATSAPP_APP_SECRET=

# === Server ===
PORT=3000
NODE_ENV=development
CORS_ORIGIN=
LOG_FORMAT=pretty

# === Gemini AI (for draft generation - Step 4) ===
GEMINI_API_KEY=

# === Snov.io (optional, manual trigger - Step 2) ===
# User must supply their own keys in the frontend Settings page
# These are encrypted at rest with AES-256-GCM
SNOVIO_API_KEY=
SNOVIO_API_SECRET=

# === ContactOut (optional, manual trigger - Step 2) ===
CONTACT_OUT_API_KEY=

# === Email Send (Resend or Brevo - Step 5) ===
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=leads@yourdomain.com

# === WhatsApp (self-hosted whatsapp-web.js - Steps 3 & 5) ===
WHATSAPP_WEB_URL=http://localhost:3050

# === Email verification (Reacher, self-hosted - Step 3) ===
REACHER_URL=http://localhost:5050

# === Adzuna (Tier 1 API, requires free registration) ===
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# === Scraper Army Configuration ===
SCRAPER_MAX_CONCURRENCY=5
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_RETRY_ATTEMPTS=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MINUTES=120

# === Anti-bot evasion (scrapers/utils/http_client.py) ===
# fetch() escalates httpx -> curl_cffi (TLS impersonation) -> Playwright+stealth.
# All optional; empty = graceful degradation (no proxies, headless, chrome TLS).
# Residential/rotating proxies unlock max yield on the hard portals
# (Naukri/LinkedIn/Indeed/Instahyre/Cutshort/Shine). Comma-separated list or single.
# Include auth as scheme://user:pass@host:port (scheme auto-added if omitted).
ROTATING_PROXIES=
PROXY_URL=
# Public volunteer proxies can MITM/log traffic — OFF by default. Only set 1 if
# you accept that for extra job-board evasion (never used for PII-bearing calls).
ALLOW_FREE_PROXIES=0
# TLS impersonation target for the curl_cffi tier (chrome | chrome124 | safari ...).
HTTP_IMPERSONATE=chrome
# Headless browser for the Playwright tier (1=headless, 0=visible for debugging).
HEADLESS=1
# CAPTCHA solving (best-effort, only used at the Playwright tier). Provider:
# 2captcha | anticaptcha. Requires an account with the chosen solver.
CAPTCHA_PROVIDER=
CAPTCHA_API_KEY=

# === Paid email enrichment (scrapers/utils/email_providers.py) ===
# OPTIONAL per-vendor keys. The cascade is FREE-FIRST: these fire only for a
# record whose email is still missing after every free/public source, one
# waterfall per record, cheapest vendor first, stops at first verified hit.
# Prefer per-user encrypted keys (Settings UI); env is a global fallback.
HUNTER_API_KEY=
APOLLO_API_KEY=
FINDYMAIL_API_KEY=
PROSPEO_API_KEY=
LUSHA_API_KEY=
ROCKETREACH_API_KEY=
NORBERT_API_KEY=
CLEARBIT_API_KEY=
LEADMAGIC_API_KEY=
ICYPEAS_API_KEY=
BSG_API_KEY=

# --- Admin bootstrap (first login) ---
# Applied automatically on `up`; creates the one admin account that can see ALL leads.
# CHANGE THESE before exposing the app.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please-32

# ---- Compliance / operational controls (see docs: FINAL AUDIT) ----
# CAN-SPAM footer: real one-click unsubscribe link + a valid postal address.
# If UNSUBSCRIBE_BASE_URL is unset, footer links fall back to mailto and the
# address line shows an explicit ACTION-REQUIRED placeholder (never fabricated).
# COMPANY_POSTAL_ADDRESS="HireGen India Pvt Ltd, <registered address>, IN"
# UNSUBSCRIBE_BASE_URL=https://app.yourdomain.example   # -> /api/optout?email=
# PUBLIC_APP_URL=https://app.yourdomain.example         # alt base for opt-out links

# Anti-spam cooldown between sends to the same lead (hours).
# SEND_COOLDOWN_HOURS=24

# Data retention (DPDP storage limitation). 0/absent = disabled (opt-in).
# Anonymises stale, never-contacted, non-suppressed personal data + trims logs.
# RETENTION_CONTACT_DAYS=180
# RETENTION_LOG_DAYS=90

# Outbound email provider webhook secret (validates bounce/complaint opt-outs).
# RESEND_WEBHOOK_SECRET=whsec_...
# WHATSAPP_APP_SECRET=...

# ---- India-fresher discovery + enrichment throughput ----
# Which sources the daily army run scrapes. Default is the India-fresher set.
# Comma-separated source names (see scrapers/scrape_consumer.py SCRAPER_MAP).
# Set empty to use the built-in India-fresher DEFAULT_SOURCES.
# SCRAPE_SOURCES=naukri,apna,internshala,hackerearth,freshersworld
#
# Concurrent contact-enrichment consumers (throughput for the enrichment priority).
# Bounded by the DB pool (10) + shared search-engine rate limits. Raise as paid
# provider keys (instant responses) are added.
# ENRICH_CONCURRENCY=4
WORKER_API_SECRET=

# ---- Access control (added by audit fix wave) ----
# Self-service /register is DISABLED by default: accounts are provisioned by an
# admin via POST /api/admin/users (email + password + role). Flip to true only if
# you genuinely want open sign-up; the /register UI only appears when the API
# reports that it is allowed.
# ALLOW_SELF_REGISTRATION=false

# /api/metrics is fail-closed: it answers 503 unless this token is set, and then
# only to callers presenting it as a Bearer token. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# METRICS_TOKEN=

# Set true when the app is served over HTTPS: cookies then carry the Secure flag
# and refresh tokens are only sent over TLS. Keep false for plain-HTTP local runs.
# COOKIE_SECURE=false

# Per-role monthly contact-credit limits (previously hardcoded at 1000).
# CREDIT_LIMIT_DEFAULT=1000
# CREDIT_LIMITS={"admin":5000,"manager":2000,"member":500}

# ---- n8n (docker-compose.yml) ----
# The old N8N_BASIC_AUTH_* variables were removed: n8n dropped HTTP basic auth in
# 1.0, so on this 2.x image they were silently ignored and the editor at
# 127.0.0.1:5678 ran with NO credential at all. The stack now pre-provisions the
# instance owner and FAILS CLOSED: until N8N_OWNER_PASSWORD_HASH is set the n8n
# container refuses to start (verified against n8nio/n8n:2.39.8). Generate it:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],12))" 'YOUR-PASSWORD'
N8N_OWNER_EMAIL=
N8N_OWNER_FIRST_NAME=Admin
N8N_OWNER_LAST_NAME=User
N8N_OWNER_PASSWORD_HASH=
